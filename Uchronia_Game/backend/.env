# Configuration de l'application
PORT=5000
NODE_ENV=development

# Configuration de la base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nom_de_votre_base_de_donnees
DB_USER=nom_d_utilisateur
DB_PASSWORD=mot_de_passe

# Configuration de l'authentification (si nécessaire)
JWT_SECRET=votre_secret_jwt
JWT_EXPIRES_IN=1h

# Configuration des CORS
CORS_ORIGIN=http://193.108.55.233,http://localhost:5000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true

# Configuration des chemins
FRONTEND_PATH=../frontend
GEOJSON_PATH=../frontend/geojson

# Configuration de la base de données SQLite (si utilisée)
SQLITE_STORAGE=./database.sqlite
